# ClaimGuard runtime
APP_NAME=ClaimGuard
APP_ENV=development
APP_VERSION=2.0.0

# Required: PostgreSQL is the normal application database.
DATABASE_URL=postgresql+psycopg://claimguard_user:CHANGE_ME@127.0.0.1:5432/claimguard_pg
# Tests require a separate database. Never set this to DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://claimguard_user:CHANGE_ME@127.0.0.1:5432/claimguard_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated exact frontend origins. Add your actual frontend origin.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# Email delivery (required only for email verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=
EMAIL_APP_PASSWORD=

# OCR
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANG=ben+eng

# Market research (optional; configure your local SearXNG endpoint)
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_API_KEY=
SEARXNG_LANGUAGE=en
SEARXNG_TIMEOUT_SECONDS=4
SEARXNG_MAX_QUERIES_PER_PRODUCT=4
MARKET_ENABLE_GOOGLE_HTML_FALLBACK=false
